# mautrix-whatsapp configuration for Sovereign
# Generated/updated by setup.sh
# Full reference: https://docs.mau.fi/bridges/go/whatsapp/index.html

homeserver:
  # URL of your Synapse instance (internal Docker hostname)
  address: http://synapse:8008
  # Must match server_name in synapse/homeserver.yaml
  domain: sovereign.local

appservice:
  # URL where Synapse can reach this bridge
  address: http://mautrix:29318
  hostname: 0.0.0.0
  port: 29318
  database:
    type: sqlite3-fk-wal
    uri: file:/data/mautrix-whatsapp.db?_txlock=immediate
  id: whatsapp
  bot:
    username: whatsappbot
    displayname: WhatsApp Bridge
    avatar: mxc://maunium.net/NeXNQarUbrlYBiPCpprYsRqr

  # Filled in by setup.sh
  as_token: "4501ce89e694fd7c18c2a8c383e5a7144f2e06cad5fe5bc59b63eb2d3108c65c"
  hs_token: "28ff7d2b133a7090cd1b07fa808c57e1438446f83226103d1dbd626dbe3949ec"

bridge:
  username_template: "whatsapp_{{.}}"
  displayname_template: "{{if .PushName}}{{.PushName}}{{else}}{{.JID}}{{end}} (WhatsApp)"
  command_prefix: "!wa"

  # Replace @sovereign:YOUR_SERVER with your actual Matrix user ID
  # This user receives bridged WhatsApp messages
  permissions:
    "*": relay
    "@sovereign:sovereign.local": user
    "@admin:sovereign.local": admin

  relay:
    enabled: false

  # Post messages as the WhatsApp user's puppeted Matrix account
  # rather than through the bridge bot
  personal_filtering_spaces: true
  bridge_matrix_leave: false
  sync_with_custom_puppets: true

  # Webhook: after receiving a WhatsApp message, post it to the connector
  # This is how the Sovereign connector learns about incoming messages
  message_status_events: false
  delivery_receipts: false
  call_start_notices: true
  identity_change_notices: false

  # How the bridge sends notifications to Synapse
  # Sovereign connector listens at this URL
  # Set to the connectors webhook endpoint
  provisioning:
    enabled: true
    prefix: /_matrix/provision

logging:
  min_level: warn
  writers:
    - type: stdout
      format: pretty-colored
      min_level: warn
