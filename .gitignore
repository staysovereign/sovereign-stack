# ── Python ────────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
.npm/

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
# keep .env.example — it's documentation, not secrets

# ── Data ─────────────────────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
data/

# ── Interface build output ────────────────────────────────────────────────────
interface/dist/
interface/node_modules/

# ── Deployment — generated files with secrets ─────────────────────────────────
# setup.sh patches these in-place with real secrets; don't commit the patched copies
# The originals (with placeholders) ARE committed as templates.
# After ./setup.sh --whatsapp the working copies will have real values — gitignore them.
synapse/homeserver.yaml.bak
backups/

# ── Docker ────────────────────────────────────────────────────────────────────
# volumes are external — nothing to ignore here

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo
.vscode/*
!.vscode/settings.json

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
