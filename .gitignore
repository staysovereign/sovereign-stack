# ── Python ────────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
.npm/

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
# keep .env.example — it's documentation, not secrets

# ── Data ─────────────────────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
data/

# ── Interface build output ────────────────────────────────────────────────────
interface/dist/
interface/node_modules/

# ── Deployment — generated files with secrets ─────────────────────────────────
# setup.sh patches these in-place with real secrets; don't commit the patched copies
# Templates with placeholders ARE committed (*.example). The patched/generated
# working copies below hold real secrets (tokens, signing/shared secrets,
# WhatsApp session) and must NEVER be committed.
synapse/homeserver.yaml
synapse/homeserver.yaml.bak
mautrix/config.yaml
mautrix/registration.yaml
mautrix/*.legacy
mautrix/*.db
mautrix/*.db-wal
mautrix/*.db-shm
backups/
.backups/

# ── Docker ────────────────────────────────────────────────────────────────────
# volumes are external — nothing to ignore here

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo
.vscode/*
!.vscode/settings.json

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
