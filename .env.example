# ── Core ──────────────────────────────────────────────────────────────────────
# Internal URL connectors use to POST normalized messages to the core
CORE_INGEST_URL=http://core:8000/ingest

# Path to the SQLite database (inside the container; mounted as Docker volume)
SOVEREIGN_DB_PATH=/data/sovereign.db

# ── Telegram ──────────────────────────────────────────────────────────────────
# Get from @BotFather: /newbot
TELEGRAM_BOT_TOKEN=

# ── Email (IMAP) ──────────────────────────────────────────────────────────────
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SECURE=true
EMAIL_IMAP_USER=you@gmail.com
EMAIL_IMAP_PASS=your-app-password

# ── WhatsApp (mautrix-whatsapp) ────────────────────────────────────────────────
# Shared secret for webhook signature validation (generate with: openssl rand -hex 32)
WHATSAPP_BRIDGE_SECRET=

# ── SMS (Twilio) ───────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Full public URL of this Sovereign instance (needed for Twilio signature validation)
TWILIO_WEBHOOK_URL=https://your-sovereign-host/sms/webhook

# ── Delivery (Layer 3) ────────────────────────────────────────────────────────
# The dumb phone's number that receives urgent SMS notifications (E.164 format)
DUMB_PHONE_NUMBER=+1234567890

# SMS gateway: set Twilio credentials above (managed), or set GAMMU_CONFIG_PATH
# for the full-sovereignty USB GSM modem path.
# Leave GAMMU_CONFIG_PATH empty to use Twilio.
GAMMU_CONFIG_PATH=

# Quiet hours (configure via the Interface in Layer 6; these are the DB defaults)
# QUIET_HOURS_ENABLED=false
# QUIET_HOURS_START=22:00
# QUIET_HOURS_END=07:00
# QUIET_HOURS_TZ=America/Lima
