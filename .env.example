# ── Core ──────────────────────────────────────────────────────────────────────
# Internal URL connectors use to POST normalized messages to the core
CORE_INGEST_URL=http://core:8000/ingest

# Path to the SQLite database (inside the container; mounted as Docker volume)
SOVEREIGN_DB_PATH=/data/sovereign.db

# ── Telegram ──────────────────────────────────────────────────────────────────
# Get from @BotFather: /newbot
TELEGRAM_BOT_TOKEN=

# ── Email (IMAP) ──────────────────────────────────────────────────────────────
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SECURE=true
EMAIL_IMAP_USER=you@gmail.com
EMAIL_IMAP_PASS=your-app-password
# How many pre-existing unseen messages to process on startup.
#   unset → 10 (safe default; a large backlog can't flood delivery)
#   0     → skip the backlog, only process mail arriving after start
#   N     → the N most recent unseen messages
#   all   → no limit (process every unseen message)
EMAIL_STARTUP_SCAN_LIMIT=10

# ── WhatsApp (mautrix-whatsapp bridge + Matrix) ───────────────────────────────
# Bridged via a private Synapse homeserver. Full setup: docs/WHATSAPP_SETUP.md
# `./setup.sh --whatsapp` prepares the Synapse config; the bridge generates its
# own config/registration, and the @sovereign user + token are created during setup.
# Matrix server name (domain only, no https://) — "sovereign.local" for LAN use.
MATRIX_SERVER_NAME=sovereign.local

# ── SMS (Twilio) ───────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Full public URL of this Sovereign instance (needed for Twilio signature validation)
TWILIO_WEBHOOK_URL=https://your-sovereign-host/sms/webhook

# ── Delivery (Layer 3) ────────────────────────────────────────────────────────
# The dumb phone's number that receives urgent SMS notifications (E.164 format)
DUMB_PHONE_NUMBER=+1234567890

# SMS gateway selection. Pick one explicitly, or leave empty to auto-detect the
# first configured one (order: twilio → infinireach → android → gammu).
#   twilio      → managed cloud (set TWILIO_* above)
#   infinireach → cloud relay that sends via your own Android phone's SIM (below)
#   android     → an Android phone running a LOCAL HTTP SMS gateway app (below)
#   gammu       → full-sovereignty USB GSM modem (set GAMMU_CONFIG_PATH)
SMS_GATEWAY=

# InfiniReach (https://infinireach.io) — Android app + cloud API. Your phone's
# SIM does the sending, so it's local-to-local and avoids foreign A2P filtering.
# Free tier ~100 SMS/month. INFINIREACH_FROM is optional (defaults to the
# phone's own number); INFINIREACH_API_URL only needed to override the endpoint.
INFINIREACH_API_KEY=
INFINIREACH_FROM=
# INFINIREACH_API_URL=https://api.infinireach.io/api/v1/messages
# Inbound replies: point InfiniReach's message.inbound webhook at
#   https://<your-public-host>/infinireach/webhook
# (the connectors port must be reachable from the internet — a tunnel works).
# Optional shared secret; if set, append ?secret=... to that webhook URL.
INFINIREACH_WEBHOOK_SECRET=

# Android phone as SMS gateway — for when a USB GSM modem isn't available.
# Run an on-phone HTTP SMS gateway app (e.g. the open-source "SMS Gateway for
# Android", capcom6/android-sms-gateway) in LOCAL SERVER mode, put the phone on
# this network, and point Sovereign at it. The phone sends via its own SIM, so
# local-to-local SMS isn't subject to foreign A2P carrier filtering.
ANDROID_SMS_GATEWAY_URL=
ANDROID_SMS_GATEWAY_USER=
ANDROID_SMS_GATEWAY_PASS=

# Full-sovereignty USB GSM modem path (python-gammu). Leave empty if unused.
GAMMU_CONFIG_PATH=

# Quiet hours (configure via the Interface in Layer 6; these are the DB defaults)
# QUIET_HOURS_ENABLED=false
# QUIET_HOURS_START=22:00
# QUIET_HOURS_END=07:00
# QUIET_HOURS_TZ=America/Lima

# ── Reply Routing (Layer 4) ────────────────────────────────────────────────────
# WhatsApp replies go via the mautrix-whatsapp Matrix bridge
MATRIX_HOMESERVER_URL=http://synapse:8008
MATRIX_ACCESS_TOKEN=

# Email SMTP (for replying to email messages; defaults to IMAP credentials if unset)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER and EMAIL_SMTP_PASS default to EMAIL_IMAP_USER / EMAIL_IMAP_PASS

# ── The Advisor (Layer 5) ─────────────────────────────────────────────────────
# Ollama runs locally in Docker — no cloud inference, ever
OLLAMA_URL=http://ollama:11434
# Model to use for suggestion generation (pull with: make ollama-pull)
OLLAMA_MODEL=llama3.2

# ── Deployment (Layer 7) ───────────────────────────────────────────────────────
# Port for the Interface (default 80; set 8080 for rootless Docker)
INTERFACE_PORT=80
